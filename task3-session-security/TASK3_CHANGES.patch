[32m+[m[32m### Session lifetime, rotation, and logout[m
 [m
[31m-```bash[m
[31m-TOKEN=$(curl --noproxy '*' --max-time 10 -sS \[m
[31m-  -H 'Content-Type: application/json' \[m
