[32m+[m[32m  curl --noproxy '*' --max-time 5 -sS -o /dev/null \[m
[32m+[m[32m    -w "attempt $attempt: HTTP %{http_code}\n" \[m
[32m+[m[32m    -H 'Content-Type: application/json' \[m
[32m+[m[32m    -d '{"email":"student.a@example.test","password":"northstar-demo-2026"}' \[m
[32m+[m[32m    http://127.0.0.1:3000/api/session[m
[32m+[m[32mdone[m
 ```[m
